<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Techmap.Server</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DefineConstants>$(DefineConstants);PACKAGED_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Techmap.Application/Techmap.Application.csproj" />
    <ProjectReference Include="../Techmap.Contracts/Techmap.Contracts.csproj" />
    <ProjectReference Include="../Techmap.Infrastructure.Sqlite/Techmap.Infrastructure.Sqlite.csproj" />
    <ProjectReference Include="../Techmap.Infrastructure.Xlsx/Techmap.Infrastructure.Xlsx.csproj" />
    <ProjectReference Include="../Techmap.Infrastructure.GoogleSheets/Techmap.Infrastructure.GoogleSheets.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="WireCatalogE3Aj.json.gz" LogicalName="Techmap.Web.WireCatalogE3Aj.json.gz" />
    <EmbeddedResource Include="../Techmap.Client/public/route-wire-illustrations/manifest.json" LogicalName="Techmap.Web.RouteWireIllustrationsManifest.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test/build outputs can be created below a project by an overridden
         BaseOutputPath. They are never application static content. -->
    <Content Remove="artifacts/**" />
    <None Remove="artifacts/**" />
  </ItemGroup>
</Project>
